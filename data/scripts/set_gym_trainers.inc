Common_EventScript_SetGymTrainers::
	switch VAR_0x8008
	case 1, KinneretTownGym_SetGymTrainers
	case 2, CoppergateCityGym_SetGymTrainers
	case 3, LenoxTownGym_SetGymTrainers
	case 4, RosebankTownGym_SetGymTrainers
	case 5, ValerytownGym_SetGymTrainers
	case 7, MiraveilIslandHall_SetGymTrainers
	end

KinneretTownGym_SetGymTrainers::
